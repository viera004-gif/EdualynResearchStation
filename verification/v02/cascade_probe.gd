extends "res://scripts/verification/run_probe.gd"
func screenshot(name: String) -> void:
	await RenderingServer.frame_post_draw
	check(bay.get_viewport().get_texture().get_image().save_png("res://verification/v02/" + name + ".png") == OK, "capture_" + name)
func pause(seconds: float) -> void:
	await bay.get_tree().create_timer(seconds).timeout
func face(node: Node3D, at: Vector3, offset: Vector3) -> void:
	await aim(at, node.global_position + offset)
	check(bay.player.target() == node, "ray_" + node.name)
func help() -> void:
	await face(bay.ai_station, Vector3(3.25, 0, 2.4), Vector3(0, 1.5, .22))
	await action("interact")
	await pause(.7)
func guidance_key() -> String:
	return bay.ai_station.screen.get_meta("localization_parameters").guidance.key
func run(world: Node) -> void:
	bay = world
	await pause(2)
	check(RenderingServer.get_rendering_device() != null, "real_gpu")
	check(bay.player.is_on_floor(), "floor_contact")
	check(bay.cooling.moving_part.find_child("ValveWheelRim", true, false).position.length() < .01, "wheel_authored_pivot")
	check(bay.relay.moving_part.find_child("LeverGrip", true, false).position.length() < .5, "relay_authored_pivot")
	var start: Vector3 = bay.player.global_position
	Input.action_press("move_forward")
	await pause(.45)
	Input.action_release("move_forward")
	await pause(.1)
	check(start.distance_to(bay.player.global_position) > .4, "player_moves")
	var motion := InputEventMouseMotion.new()
	motion.relative = Vector2(20, 5)
	var yaw: float = bay.player.rotation.y
	Input.parse_input_event(motion)
	await wait_frames(3)
	check(abs(bay.player.rotation.y - yaw) > .01, "mouse_look")
	await face(bay.terminal, Vector3(-2.9, 0, -.3), Vector3(0, 1.56, 0))
	await action("interact")
	check(bay.history.running, "intervention_started")
	# Actual configured no-progress interval; never alter gameplay thresholds in test.
	await pause(float(bay.config.adaptive_help.prolonged_no_progress_seconds) + .2)
	check(bay.help_salient, "configured_no_progress_salience")
	await help()
	check(guidance_key() == "help.level1.power_coupling.early", "early_help_encourages_exploration")
	await screenshot("01_support")
	await face(bay.module, Vector3(-1.7, 0, 1.45), Vector3(0, .18, 0))
	await action("interact")
	check(bay.player.held == bay.module, "physical_module_pickup")
	await face(bay.correct_socket, Vector3(2.05, 0, .1), Vector3(0, .11, 0))
	await action("place")
	await pause(.12)
	check(bay.module.position.z > .05 and not bay.correct_socket.locked, "early_physical_rejection")
	await pause(.4)
	await action("place")
	await pause(.4)
	await action("place")
	await pause(.4)
	check(bay.history.exact_repeats == 2 and bay.help_salient, "exact_repeat_salience")
	await action("rotate_right")
	await pause(.25)
	check(bay.history.last_change_candidate == "PARAMETER_ADJUSTMENT", "orientation_signature_adjustment")
	check(bay.module.orientation_step == 1 and abs(bay.module.rotation.y - PI/2) < .02, "physical_rotation")
	await action("place")
	await pause(.4)
	check(bay.history.exact_repeats == 0, "adjustment_breaks_repeat")
	await face(bay.wrong_socket, Vector3(.95, 0, .1), Vector3(0, .11, 0))
	await action("place")
	check(bay.history.last_change_candidate == "TARGET_CHANGE", "target_change_signature")
	await pause(.4)
	# Put the module on a real floor hit; retain scanner as a distinct handheld tool.
	await aim(Vector3(0, 0, 1.2), Vector3(0, 0, .3))
	await action("put_down")
	check(bay.player.held == null and bay.module.state == bay.module.State.AVAILABLE, "module_put_down")
	await face(bay.relay, Vector3(0, 0, -2.1), Vector3(0, 1.45, .3))
	await action("interact")
	await pause(.14)
	check(abs(bay.relay.moving_part.rotation.z) > .05 and not bay.relay_ready, "relay_physical_rejection")
	check(bay.history.last_change_candidate == "SUBSYSTEM_SWITCH", "subsystem_switch_signature")
	await pause(.4)
	await face(bay.cooling, Vector3(-1.35, 0, -2.1), Vector3(0, 1.45, .3))
	await action("inspect")
	check(bay.history.last_change_candidate == "INFORMATION_SEEK", "inspection_signature")
	await help()
	check(guidance_key() == "help.level2.power_coupling.cooling", "help_level_2")
	await help()
	check(guidance_key() == "help.level3.power_coupling.cooling", "help_level_3_cooling")
	await face(bay.scanner, Vector3(-3.2, 0, 2.9), Vector3(0, .2, 0))
	await action("interact")
	check(bay.player.held == bay.scanner and bay.scanner.get_parent() == bay.player.carry_anchor, "scanner_physical_pickup")
	for node in [bay.cooling, bay.relay, bay.correct_socket]:
		var at: Vector3 = Vector3(node.global_position.x, 0, -2.1) if node != bay.correct_socket else Vector3(2.05, 0, .1)
		var offset := Vector3(0, 1.45, .3) if node != bay.correct_socket else Vector3(0, .11, 0)
		await face(node, at, offset)
		await action("place")
		await pause(.8)
		check(bay.scanner.screen.text == bay.localization.text(node.scan_status()), "scanner_status_" + node.name)
		check(bay.history.last_change_candidate == "TOOL_USE", "scanner_signature")
	await screenshot("02_scanner")
	await face(bay.cooling, Vector3(-1.35, 0, -2.1), Vector3(0, 1.45, .3))
	await action("interact")
	check(not bay.cooling_ready, "cooling_waits_for_motion")
	await pause(1)
	check(bay.cooling_ready and abs(bay.cooling.moving_part.rotation.z - PI/2) < .02, "cooling_physical_ready")
	await help()
	check(guidance_key() == "help.level3.power_coupling.relay", "help_level_3_relay")
	await face(bay.relay, Vector3(0, 0, -2.1), Vector3(0, 1.45, .3))
	await action("interact")
	await pause(.7)
	check(bay.relay_ready and abs(bay.relay.moving_part.rotation.z + PI/3) < .02, "relay_dependency_activation")
	await face(bay.correct_socket, Vector3(2.05, 0, .1), Vector3(0, .11, 0))
	await action("place")
	await pause(.8)
	check(bay.scanner.screen.get_meta("localization_key") == "diagnostic.interface_ready", "scanner_updated_context")
	await help()
	check(guidance_key() == "help.level3.power_coupling.coupler", "help_level_3_coupler")
	await aim(Vector3(-3.2, 0, 2.9), Vector3(-3.2, 1.05, 1.5))
	await action("put_down")
	check(bay.player.held == null and not bay.scanner.carried, "scanner_put_down")
	await face(bay.module, Vector3(0, 0, 1.5), Vector3(0, .18, 0))
	await action("interact")
	await face(bay.correct_socket, Vector3(2.05, 0, .1), Vector3(0, .11, 0))
	await action("place")
	check(not bay.correct_socket.locked and bay.player.held == bay.module, "wrong_orientation_rejected_after_dependencies")
	await pause(.4)
	await action("rotate_right")
	await pause(.25)
	await action("place")
	check(bay.correct_socket.locked and bay.module.get_parent() == bay.correct_socket and bay.player.held == null, "snap_lock_recovered_without_restart")
	var rotor: Basis = bay.machine.rotor.basis
	var core_y: float = bay.machine.core.position.y
	await pause(5)
	check(bay.phase == bay.Phase.COMPLETE and bay.stage == "SYSTEM_ACTIVE", "mission_completed")
	check(not bay.machine.rotor.basis.is_equal_approx(rotor) and bay.machine.core.position.y > core_y + .1, "machine_realtime_startup")
	check(bay.stage_history == ["SYSTEM_OFFLINE", "COOLING_UNRESOLVED", "COOLING_READY", "RELAY_UNRESOLVED", "RELAY_READY", "COUPLING_READY", "MODULE_LOCKED", "SYSTEM_ACTIVE"], "complete_dependency_states")
	for cue in bay.audio.EXTRA_CUES:
		check(bay.audio.cue_counts[cue] > 0, "audio_" + cue)
	check(bay.audio.nonzero_frames > 1000 and bay.audio.mixed_peak < .5, "audio_mixed_with_headroom")
	await aim(Vector3(0, 0, 1.95), Vector3(1.35, 1.5, -2.6))
	await screenshot("03_active")
	var deadline := Time.get_ticks_msec() + 12000
	if not bay.telemetry.base_url.contains(":1/"):
		while not bay.telemetry.session_closed and Time.get_ticks_msec() < deadline:
			await wait_frames(1)
	var suffix := "offline" if bay.telemetry.base_url.contains(":1/") else "online"
	check(bay.telemetry.pending.size() > 0 if suffix == "offline" else bay.telemetry.session_closed, "telemetry_transport")
	report["fps_mean"] = float(bay.frame_count - 90) / maxf(.001, bay.measured_seconds)
	report["fps_engine"] = Engine.get_frames_per_second()
	report["audio"] = bay.audio.report()
	report["profile"] = bay.metrics.report(bay)
	report["all_gameplay_checks_passed"] = not failed
	bay.telemetry.export_trace("res://verification/v02/telemetry_" + suffix + ".json")
	var file := FileAccess.open("res://verification/v02/runtime_" + suffix + ".json", FileAccess.WRITE)
	file.store_string(JSON.stringify(report, "\t"))
	print("V02_REPORT ", JSON.stringify(report))
	bay.get_tree().quit(2 if failed else 0)
